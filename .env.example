# Local SQLite database file.
DATABASE_URL="file:./dev.db"

# Auth.js session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Google OAuth client — create in Google Cloud Console > APIs & Services >
# Credentials (type: Web application), with an authorized redirect URI of
# http://localhost:3003/api/auth/callback/google for local dev.
AUTH_GOOGLE_ID="change-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="change-me"

# Comma-separated, case-insensitive allowlist of emails permitted to sign in.
ALLOWED_EMAILS="you@example.com,partner@example.com"
